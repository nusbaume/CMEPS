module test_wtracer_flux_coare

  ! Water tracer tests of flux_atmOcn_COARE (COARE v3.0 bulk scheme)

  use funit
  use shr_kind_mod,          only : r8 => shr_kind_r8
  use shr_water_species_mod, only : WATER_SPECIES_TYPE_BULK
  use shr_wtracers_mod,      only : stub_wtracers_set_species
  use flux_atmocn_COARE_mod, only : flux_atmOcn_COARE
  use flux_test_fixtures

  implicit none

  integer, parameter :: logunit = 6

  ! Tracer/bulk water ratios used by the scaling tests
  real(r8), parameter :: test_ratios(3) = [0.5_r8, 2.0e-3_r8, 3.0_r8]

contains

  @before
  subroutine setUp()
    call fixture_init()
  end subroutine setUp

  @after
  subroutine tearDown()
    call fixture_reset()
  end subroutine tearDown

  !-----------------------------------------------------------------------------
  subroutine check_bulk_tracer_scales_with_bulk_water(state, ratio)
    ! Run the scheme with one bulk-type water tracer whose water masses are a constant
    ! ratio of regular (bulk) water, in both the atmosphere (qbot_wtracers = ratio*qbot)
    ! and the ocean (roce_wtracers = ratio), and check that the tracer's evaporative
    ! flux and two-meter reference humidity are that same ratio of bulk water's.
    ! With ratio = 1 the tracer must match bulk water.
    type(flux_inputs_t), intent(in) :: state
    real(r8),            intent(in) :: ratio ! tracer / bulk water ratio

    integer, parameter :: nTracers = 1
    real(r8), dimension(state%nMax) :: sen, lat, lwup, evap, taux, tauy, tref, qref
    real(r8), dimension(state%nMax) :: duu10n, ugust_out, u10res
    real(r8), dimension(nTracers, state%nMax) :: qbot_wtracers, roce_wtracers
    real(r8), dimension(nTracers, state%nMax) :: evap_wtracers, qref_wtracers
    integer :: n

    call stub_wtracers_set_species([WATER_SPECIES_TYPE_BULK])

    qbot_wtracers(1,:) = ratio * state%qbot
    roce_wtracers(1,:) = ratio

    call flux_atmOcn_COARE(logunit=logunit, spval=test_spval, nMax=state%nMax, &
         zbot=state%zbot, ubot=state%ubot, vbot=state%vbot, thbot=state%thbot, &
         qbot=state%qbot, rainc=state%rainc, rbot=state%rbot, &
         tbot=state%tbot, us=state%us, vs=state%vs, pslv=state%pslv, &
         ts=state%ts, mask=state%mask, seq_flux_atmocn_minwind=test_minwind, &
         sen=sen, lat=lat, lwup=lwup, evap=evap, &
         taux=taux, tauy=tauy, tref=tref, qref=qref, &
         aofluxes_use_shr_wv_sat=.true., &
         duu10n=duu10n, ugust_out=ugust_out, u10res=u10res, &
         qbot_wtracers=qbot_wtracers, roce_wtracers=roce_wtracers, &
         evap_wtracers=evap_wtracers, qref_wtracers=qref_wtracers)

    do n = 1, state%nMax
       @assertEqual(ratio*evap(n), evap_wtracers(1,n), tolerance=tol_exact*abs(ratio*evap(n)))
       @assertEqual(ratio*qref(n), qref_wtracers(1,n), tolerance=tol_exact*abs(ratio*qref(n)))
    end do

  end subroutine check_bulk_tracer_scales_with_bulk_water

  @test
  subroutine test_bulk_tracer_matches_bulk_water_unstable()
    ! Bulk tracer equals bulk water for evaporation from a warm ocean.
    call check_bulk_tracer_scales_with_bulk_water(make_unstable_state(nMax=1), ratio=1.0_r8)
  end subroutine test_bulk_tracer_matches_bulk_water_unstable

  @test
  subroutine test_bulk_tracer_matches_bulk_water_stable()
    ! Bulk tracer equals bulk water for condensation onto a cool ocean.
    call check_bulk_tracer_scales_with_bulk_water(make_stable_state(nMax=1), ratio=1.0_r8)
  end subroutine test_bulk_tracer_matches_bulk_water_stable

  @test
  subroutine test_bulk_tracer_scales_with_bulk_water_unstable()
    ! Bulk tracer evaporation and two-meter humidity scale with the tracer/bulk
    ! water ratio, for evaporation from a warm ocean. The ratios cover a
    ! fraction, an isotope-like ratio (~H218O/H2O) and a ratio above one.
    integer :: i
    do i = 1, size(test_ratios)
       call check_bulk_tracer_scales_with_bulk_water(make_unstable_state(nMax=1), test_ratios(i))
       if (anyExceptions()) return
    end do
  end subroutine test_bulk_tracer_scales_with_bulk_water_unstable

  @test
  subroutine test_bulk_tracer_scales_with_bulk_water_stable()
    ! Bulk tracer condensation and two-meter humidity scale with the tracer/bulk
    ! water ratio, for condensation onto a cool ocean.
    integer :: i
    do i = 1, size(test_ratios)
       call check_bulk_tracer_scales_with_bulk_water(make_stable_state(nMax=1), test_ratios(i))
       if (anyExceptions()) return
    end do
  end subroutine test_bulk_tracer_scales_with_bulk_water_stable

end module test_wtracer_flux_coare
